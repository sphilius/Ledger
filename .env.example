# =============================================================================
# Ledger environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT-SIDE (safe to expose to the browser)
# -----------------------------------------------------------------------------
# Vite ONLY exposes variables prefixed with `VITE_` to client code. The Supabase
# anon key is public by design: it is protected by Row Level Security policies,
# so it is safe to ship to the browser. Do NOT put any other secret here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# -----------------------------------------------------------------------------
# SERVER-ONLY (NEVER expose to the browser)
# -----------------------------------------------------------------------------
# These are read ONLY by the /server layer and Supabase Edge Functions.
# They must NEVER be prefixed with `VITE_` and must NEVER be imported from /src.
# The service-role key bypasses Row Level Security — treat it like a root password.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Plaid (bank linking) — all Plaid calls happen server-side.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# Local /server layer
PORT=8787
